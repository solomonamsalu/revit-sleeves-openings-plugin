  "systems": {
    "exhaust": {
      "clearanceEachSide": 2,
      "roofIncreaseTotal": 4,
      "floorPlanWinsOverRiserDiagram": true
    },
    "garbageChute": {
      "fixedWidth": 28.5,
      "fixedLength": 28.5,
      "roofClearance": 0,
      "allowOffset": false
    },
    "dryerExhaust": {
      "radius": 2,
      "roofOpeningWidth": 6,
      "roofOpeningLength": 6,
      "minSpacing": 8
    },
    "motorizedDamper": {
      "clearanceEachSide": 2
    },
    "refrigeration": {
      "downHeight": 0,
      "linesPerIndoorUnitSplit": 2,
      "roofExtraWidth": 3,
      "roofExtraLength": 3
    },
    "electrical": {
      "conduitSpacingCenterToCenter": 0.75,
      "extraCirclesForRoof": 1,
      "roofSleeveDiameter": 2
    },
    "storm": {
      "sleeveOverPipe": 2,
      "areaDrainDiameter": 10,
      "areaDrainCount": 2,
      "areaDrainSpacingCenterToCenter": 24,
      "detailDeckEdgeOffset": 12
    },
    "condensate": {
      "sleeveDiameter": 3
    },
    "standpipe": {
      "sleeveOverPipe": 2,
      "minCenterToWall": 5.5,
      "minCenterToCenter": 8
    },
    "bathtub": {
      "options": {
        "two6": { "count": 2, "diameter": 6 },
        "one10": { "count": 1, "diameter": 10 }
      },
      "default": null
    }
