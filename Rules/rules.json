{
  "version": 1,
  "_comment": "All lengths are in INCHES. Source: Sleeves & Openings Standards Manual. Edit family names/params to match your library.",

  "families": {
    "regularOpening": {
      "family": "Regular Opening",
      "type": null,
      "file": "Families/Regular Opening.rfa",
      "widthParam": "Width",
      "lengthParam": "Length",
      "nameParam": "Comments"
    },
    "pipeReferenceOpening": {
      "family": "Pipe Reference Opening",
      "type": null,
      "file": "Families/Pipe Reference Opening.rfa",
      "widthParam": "Width",
      "lengthParam": "Length",
      "nameParam": "Comments",
      "downHeightParam": "Down Height"
    },
    "roundSleeve": {
      "family": "Round Sleeve",
      "type": null,
      "file": "Families/Round Sleeve.rfa",
      "diameterParam": "Diameter",
      "nameParam": "Comments"
    },
    "electricalOpening": {
      "family": "Electrical Opening",
      "type": null,
      "file": "Families/Electrical Opening.rfa",
      "widthParam": "Width",
      "lengthParam": "Length",
      "nameParam": "Comments"
    }
  },

  "naming": {
    "electrical": "ELECTRIC",
    "dryerExhaust": "DE",
    "exhaustPattern": "{riser}"
  },

  "systems": {
    "exhaust": {
      "clearanceEachSide": 2,
      "roofIncreaseTotal": 4,
      "floorPlanWinsOverRiserDiagram": true
    },
    "garbageChute": {
      "fixedWidth": 28.5,
      "fixedLength": 28.5,
      "roofClearance": 0,
      "allowOffset": false
    },
    "dryerExhaust": {
      "radius": 2,
      "roofOpeningWidth": 6,
      "roofOpeningLength": 6,
      "minSpacing": 8
    },
    "motorizedDamper": {
      "clearanceEachSide": 2
    },
    "refrigeration": {
      "downHeight": 0,
      "linesPerIndoorUnitSplit": 2,
      "roofExtraWidth": 3,
      "roofExtraLength": 3,
      "inchesPerLine": 1.5,
      "minLength": 6
    },
    "electrical": {
      "conduitSpacingCenterToCenter": 0.75,
      "extraCirclesForRoof": 1,
      "roofSleeveDiameter": 2,
      "circleDiameter": 0.75,
      "openingMargin": 0
    },
    "storm": {
      "sleeveOverPipe": 2,
      "areaDrainDiameter": 10,
      "areaDrainCount": 2,
      "areaDrainSpacingCenterToCenter": 24,
      "detailDeckEdgeOffset": 12
    },
    "condensate": {
      "sleeveDiameter": 3
    },
    "standpipe": {
      "sleeveOverPipe": 2,
      "minCenterToWall": 5.5,
      "minCenterToCenter": 8
    },
    "bathtub": {
      "options": {
        "two6": { "count": 2, "diameter": 6 },
        "one10": { "count": 1, "diameter": 10 }
      },
      "default": null
    }
  },

  "clearances": {
    "minFromColumn": 12,
    "minFromWallEdge": 4,
    "roofMinFromWallOrCurb": 12,
    "roofMinBetweenOpenings": 24,
    "ervSpacingExact": 24,
    "midRoomDistance": 36
  },

  "viewRange": {
    "topLevelAboveOffset": 0,
    "bottomAssociatedLevelOffset": 0
  },

  "levelClassification": {
    "_comment": "Regex (case-insensitive) matched against level names. First match wins; unmatched levels are treated as apartment floors.",
    "roof": "roof|rf\b",
    "bulkhead": "bulkhead|bh\b|penthouse mech",
    "setback": "setback|terrace",
    "cellar": "cellar|basement|sub|garage|foundation"
  },

  "generalRules": {
    "_comment": "Confirmed at the start of Project Setup and before any work (manual p.2). A No blocks the add-in.",
    "mustConfirm": [
      "I am working from the Owner's plan, not the Approved plan.",
      "I checked and confirmed this file is the latest version."
    ],
    "reconfirmEveryDay": true
  },

  "fixtures": {
    "_comment": "Manual p.2 'Always verify': the add-in finds these fixtures in the model (family/type/category name matched case-insensitively) and checks the sleeves against them in Final Check. Lengths in inches.",
    "showerDrain": { "match": "shower.?drain|linear.?drain|trench.?drain|floor.?drain|shower", "pipeSize": 2, "sleeveRadius": 24 },
    "toilet":      { "match": "toilet|water.?closet|\\bwc\\b", "wallHungMatch": "wall.?hung|wall.?mount|carrier|back.?to.?wall", "pipeSize": 4, "sleeveRadius": 24 },
    "medicineCabinet": { "match": "medicine.?cabinet|med.?cab", "clearance": 2 },
    "niche":       { "match": "niche|recess", "clearance": 2 }
  }
}
